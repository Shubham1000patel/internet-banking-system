```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Local database files and backups
*.sql
*.sqlite3
*.db

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build output
build/
dist/
*.egg-info/

# Local uploads and generated reports
uploads/
reports/
